# 문의·신청 폼 접수 주소 (Formspree 등 무료 폼 서비스)
# 비워 두면 방문자의 메일 앱이 열려 같은 내용을 사업회 주소로 보냅니다.
NEXT_PUBLIC_FORM_ENDPOINT=

# 사이트가 실제로 열리는 주소 (sitemap·검색엔진 안내용)
# 도메인을 연결하면 https://www.camptiano.kr 로 바꿔 주세요.
NEXT_PUBLIC_SITE_URL=

# GitHub Pages 하위 경로.
# GitHub 기본 주소로 열 때: /Camptiano-Home-Page
# 직접 구매한 도메인으로 열 때: (빈 값)
BASE_PATH=
